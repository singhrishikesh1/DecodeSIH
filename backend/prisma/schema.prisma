generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ───────────────────────────────────────────────────────────────────
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  role      String   @default("INSPECTOR")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ─── Drone ──────────────────────────────────────────────────────────────────
model Drone {
  id             String   @id
  name           String
  model          String
  status         String   @default("STANDBY")
  assignedArea   String?  @map("assigned_area")
  lat            Float?
  lng            Float?
  altitude       Float?
  speedKmH       Float?   @map("speed_km_h")
  batteryPercent Int?     @map("battery_percent")
  rotorHealth    Int?     @map("rotor_health")
  cameraStream   String?  @map("camera_stream")
  lastServiceDate String? @map("last_service_date")
  nextServiceDue  String? @map("next_service_due")
  totalFlightHours Float? @map("total_flight_hours")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  missions Mission[]

  @@map("drones")
}

// ─── Mission ────────────────────────────────────────────────────────────────
model Mission {
  id        String    @id @default(uuid())
  droneId   String?   @map("drone_id")
  startTime DateTime? @map("start_time")
  endTime   DateTime? @map("end_time")
  status    String    @default("PLANNED")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  drone       Drone?       @relation(fields: [droneId], references: [id])
  inspections Inspection[]

  @@index([droneId])
  @@map("missions")
}

// ─── Inspection ─────────────────────────────────────────────────────────────
model Inspection {
  id                   String    @id @default(uuid())
  missionId            String?   @map("mission_id")
  legacyId             String?   @unique @map("legacy_id")
  assetName            String    @map("asset_name")
  assetType            String    @map("asset_type")
  locationName         String?   @map("location_name")
  latitude             Float?
  longitude            Float?
  altitude             Float?
  imageUrl             String?   @map("image_url")
  annotatedImageUrl    String?   @map("annotated_image_url")
  status               String    @default("COMPLETED")
  errorMessage         String?   @map("error_message")
  timestamp            DateTime  @default(now())
  modelVersion         String?   @map("model_version")
  processingTimestamp  DateTime? @map("processing_timestamp")

  // Legacy compat fields (denormalized from potholes for old frontend)
  title                String?
  inspector            String?
  alertSent            Boolean   @default(false) @map("alert_sent")
  thumbnailUrl         String?   @map("thumbnail_url")

  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  mission   Mission?  @relation(fields: [missionId], references: [id])
  potholes  Pothole[]

  @@index([timestamp])
  @@index([status])
  @@index([assetType])
  @@index([legacyId])
  @@map("inspections")
}

// ─── Pothole ────────────────────────────────────────────────────────────────
model Pothole {
  id               String   @id @default(uuid())
  potholeId        String?  @unique @map("pothole_id") // Persistent sequential ID: P001, P002...
  inspectionId     String   @map("inspection_id")
  defectClass      String   @map("defect_class")
  confidence       Float?
  areaM2           Float?   @map("area_m2")
  depthM           Float?   @map("depth_m")
  depthType        String?  @map("depth_type")
  volumeM3         Float?   @map("volume_m3")
  lengthM          Float?   @map("length_m")
  widthM           Float?   @map("width_m")
  severity         String?
  riskScore        Int?     @map("risk_score")
  riskReasons      Json?    @map("risk_reasons")
  recommendedAction  String? @map("recommended_action")

  // GPS / location
  gpsAvailable     Boolean  @default(false) @map("gps_available")
  gpsStatus        String?  @default("unavailable") @map("gps_status")

  // Repair cost breakdown
  materialType     String?  @map("material_type")
  materialQuantity String?  @map("material_quantity")
  materialCost     Float?   @map("material_cost")
  labourCost       Float?   @map("labour_cost")
  equipmentCost    Float?   @map("equipment_cost")
  totalRepairCost  Float?   @map("total_repair_cost")
  costCurrency     String?  @default("₹") @map("cost_currency")
  requiredMaterials Json?   @map("required_materials")

  // Image association (actual saved pothole image)
  imagePath        String?  @map("image_path")

  // Cost estimator selection (road/material/repair) + linked persisted estimate
  roadMaterial     String?  @map("road_material")
  roadType         String?  @map("road_type")
  repairMethod     String?  @map("repair_method")
  regionState      String?  @map("region_state")
  regionCity       String?  @map("region_city")
  roadAuthority    String?  @map("road_authority")
  costEstimateId   String?  @map("cost_estimate_id")
  avgDepthCm       Float?   @map("avg_depth_cm")
  maxDepthCm       Float?   @map("max_depth_cm")

  // Live-pipeline persisted metadata (already present in DB)
  measurementStatus String? @map("measurement_status")
  severityBasis     String? @map("severity_basis")
  severityStatus    String? @map("severity_status")
  detectedAt        DateTime? @map("detected_at")
  lidarStatus       String? @map("lidar_status")
  costConfigId      String? @map("cost_config_id")

  // Legacy / internals
  estimatedCost    Float?   @map("estimated_cost")
  bbox             Json?

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  inspection Inspection @relation(fields: [inspectionId], references: [id])
  costEstimate CostEstimate?

  @@index([inspectionId])
  @@index([severity])
  @@index([potholeId])
  @@map("potholes")
}

// ─── PotholeSequence ─────────────────────────────────────────────────────────
// Single-row counter for atomic persistent P001/P002/... ID generation.
model PotholeSequence {
  id      String @id @default("default")
  current Int    @default(0) @map("current_value")

  @@map("pothole_sequences")
}

// ─── CostConfig ─────────────────────────────────────────────────────────────
model CostConfig {
  id              String   @id @default(uuid())
  materialRate    Float?   @map("material_rate")
  labourRate      Float?   @map("labour_rate")
  equipmentRate   Float?   @map("equipment_rate")
  transportRate   Float?   @map("transport_rate")
  contingencyRate Float?   @map("contingency_rate")
  currency        String   @default("₹")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("cost_configs")
}

// ─── CostRate ───────────────────────────────────────────────────────────────
// Regional, versioned rate catalog (material / labour / equipment / transport).
// One row per rate line. Historical rows are kept via effective_from/effective_to.
model CostRate {
  id              String   @id
  category        String // MATERIAL | LABOUR | EQUIPMENT | TRANSPORT
  name            String
  specification   String?
  unit            String
  rate            Float
  currency        String   @default("INR")
  state           String?
  city            String?
  authority       String? // NHAI | State PWD | Municipal | Market | National
  source          String?
  sourceReference String?  @map("source_reference")
  effectiveFrom   DateTime? @map("effective_from")
  effectiveTo     DateTime? @map("effective_to")
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([state, city])
  @@index([name])
  @@map("cost_rates")
}

// ─── CostEstimate ───────────────────────────────────────────────────────────
// Persisted, reproducible engineering repair estimate for one pothole.
// Stores the full rate snapshot + BOQ so an old estimate does not silently
// change when the rate catalog is updated later.
model CostEstimate {
  id                String   @id @default(uuid())
  potholeId         String?  @unique @map("pothole_id")
  roadMaterial      String?  @map("road_material")
  roadType          String?  @map("road_type")
  repairMethod      String?  @map("repair_method")
  regionState       String?  @map("region_state")
  regionCity        String?  @map("region_city")
  roadAuthority     String?  @map("road_authority")
  geometry          Json?
  rateSnapshot      Json?    @map("rate_snapshot")
  ratesMaterials    Json?    @map("rates_materials")
  ratesLabour       Json?    @map("rates_labour")
  ratesEquipment    Json?    @map("rates_equipment")
  ratesTransport    Json?    @map("rates_transport")
  materials         Json?
  labour            Json?
  equipment         Json?
  transport         Json?
  materialSubtotal  Float?   @map("material_subtotal")
  labourSubtotal    Float?   @map("labour_subtotal")
  equipmentSubtotal Float?   @map("equipment_subtotal")
  transportSubtotal Float?   @map("transport_subtotal")
  allowance         Float?
  subtotal          Float?
  tax               Float?
  contingency       Float?
  total             Float?
  currency          String   @default("INR")
  rateSource        String?  @map("rate_source")
  rateEffectiveDate String?  @map("rate_effective_date")
  formula           Json?
  calculationStatus String   @default("CALCULATED") @map("calculation_status")
  calculatedAt      DateTime @default(now()) @map("calculated_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  pothole Pothole? @relation(fields: [potholeId], references: [id])

  @@map("cost_estimates")
}
